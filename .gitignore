.Rproj.user
.Rhistory
.RData
.Ruserdata
/.quarto/
_publish.yml

# Rendered book output — published by GitHub Actions to the gh-pages branch,
# so it should NOT be tracked on main.
/_book/
/docs/

# Large / copyrighted source PDFs (Rasch texts, textbook scans) — kept locally
# as reference material, never committed to the public repo.
*.pdf

# Standalone Quarto render artifacts for the Module demos (rendered outside the
# book). Keep the Module*.qmd source; ignore the rendered .html + its _files/
# sidecar of figures/JS libs. (The book itself renders to _book/, ignored above.)
Module*.html
Module*_files/
