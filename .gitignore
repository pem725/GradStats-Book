.Rproj.user
.Rhistory
.RData
.Ruserdata
/.quarto/
_publish.yml

# Rendered book output — published by GitHub Actions to the gh-pages branch,
# so it should NOT be tracked on main.
/_book/
/docs/

# Large / copyrighted source PDFs (Rasch texts, textbook scans) — kept locally
# as reference material, never committed to the public repo.
*.pdf

# Standalone Quarto render artifacts for the Module demos (rendered outside the
# book). Keep the Module*.qmd source; ignore the rendered .html + its _files/
# sidecar of figures/JS libs. (The book itself renders to _book/, ignored above.)
Module*.html
Module*_files/

# Python virtual environment (for testing the book's Python code)
.venv/
__pycache__/
*.pyc
_figs/

# stray PSPP chart output from running syntax at the repo root
pspp.png

# Local cache for the Jeff DOCX round trip (baselines + manifest)
.jeff-sync/

# Quarto artifacts from rendering a chapter at the repo root rather than into
# _book/. A stray `quarto render <chapter>.qmd --to <fmt>` drops these here, and
# a `git add -A` then commits them. Named explicitly rather than with a broad
# *_files/ glob, because _poc_engines.html and _poc_engines_files/ are tracked
# on purpose and a glob would silently untrack them.
/[0-9][0-9]-*.html
/[0-9][0-9]-*_files/
/index.html
/intro.html
/preface.html
/foreword.html
/author.html
/references.html
/setup.html
/changelog.html
/required-packages.html
/three-languages.html
/site_libs/
/*.rmarkdown
